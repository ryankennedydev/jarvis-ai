# ============================================================
#  JARVIS - configuração (copie para .env ou rode: python configurar.py)
#  O arquivo .env NUNCA deve ser compartilhado nem versionado.
# ============================================================

# --- Credenciais ---------------------------------------------
# Qual IA usar: anthropic (Claude) | openai (GPT) | gemini (Google)
JARVIS_PROVEDOR=anthropic
# Só a chave do provedor escolhido é obrigatória.
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Segurança -----------------------------------------------
# Hash do PIN de acesso (gerado pelo configurar.py). Vazio = sem PIN.
JARVIS_PIN_HASH=
# Tentativas de PIN antes de fechar o app
JARVIS_PIN_TENTATIVAS=5
# Bloqueia o app após N minutos sem uso (0 = desativado)
JARVIS_BLOQUEIO_MINUTOS=15
# Domínios que o Jarvis pode abrir no navegador (vazio = qualquer https)
JARVIS_SITES_PERMITIDOS=

# --- Cérebro (modelo) ----------------------------------------
# Modelo de cada provedor (vale o do provedor escolhido acima)
JARVIS_MODELO=claude-opus-5-5
JARVIS_MODELO_OPENAI=gpt-5
JARVIS_MODELO_GEMINI=gemini-3.5-flash
# Profundidade de raciocínio: low | medium | high | xhigh | max
JARVIS_ESFORCO=medium
# Esforço dos agentes de IA do módulo Work (os gerentes usam JARVIS_ESFORCO)
JARVIS_ESFORCO_AGENTES=medium
# Raciocínio dos pedidos por voz (menor = responde mais rápido)
JARVIS_ESFORCO_VOZ=low
# Permite ao Jarvis pesquisar na internet (true/false). Só funciona com o Claude.
JARVIS_BUSCA_WEB=true

# --- Personalização ------------------------------------------
JARVIS_NOME_USUARIO=Senhor
# Tamanho da interface: auto (ajusta à tela) ou um número, ex.: 1.5
# Dentro do app: Ctrl + / Ctrl - / Ctrl 0 também ajustam.
JARVIS_ZOOM=auto

# --- Voz (microfone) -----------------------------------------
# Transcrição 100% local (Whisper): o áudio não sai do computador.
JARVIS_VOZ=true
# Fica ouvindo o tempo todo, esperando você dizer "Jarvis, ..."
JARVIS_ESCUTA_CONTINUA=true
# true = só responde quando a frase começa com "Jarvis" (recomendado)
JARVIS_PALAVRA_ATIVACAO=true
# tiny | base | small | medium  (maior = mais preciso e mais lento)
JARVIS_MODELO_VOZ=small

# --- Voz do Jarvis (alto-falante) ------------------------------
# Síntese 100% local (Piper): o texto não sai do computador.
JARVIS_FALA=true
# false = só fala quando você pediu pelo microfone | true = fala toda resposta
JARVIS_FALA_SEMPRE=true
# Vozes em https://huggingface.co/rhasspy/piper-voices (pt_BR: faber, cadu, jeff, edresson)
JARVIS_VOZ_FALA=pt_BR-faber-medium
# 1.0 = normal, 1.2 = mais rápido, 0.9 = mais devagar
JARVIS_FALA_VELOCIDADE=1.0
